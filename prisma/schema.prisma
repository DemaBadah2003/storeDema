generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        Int      @id @default(autoincrement())
  city      String
  country   String
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart?                // ← أضيفي هذا
}

model Product {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image       String?
  category    String?
  stock       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cartItems   CartItem[]
}

model Cart {
  id        Int        @id @default(autoincrement())  // ← Int مثل User
  userId    Int        @unique                         // ← Int مثل User.id
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int                                        // ← Int مثل Cart.id
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int                                        // ← Int مثل Product.id
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

enum Country {
  PALESTINE
  JORDAN
  SAUDI_ARABIA
  UAE
  EGYPT
  KUWAIT
  QATAR
  BAHRAIN
  OMAN
  LEBANON
}